# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como .env.local y rellena los valores.
# En Vercel: Settings → Environment Variables
# ============================================================

# ── BASE DE DATOS ────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ── AUTENTICACIÓN ADMIN ──────────────────────────────────────
ADMIN_USERNAME="barbero"
ADMIN_PASSWORD="password-seguro-aqui"
ADMIN_SETUP_TOKEN=""           # Token de recuperación de emergencia (opcional)
JWT_SECRET="clave-secreta-larga-y-aleatoria"

# ── NOTIFICACIONES ───────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL="barbero@ejemplo.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── EMAIL (Resend) ───────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Nombre Barbería <no-reply@tudominio.com>"

# ── RATE LIMITING (Upstash Redis, opcional) ──────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── INFORMACIÓN DEL NEGOCIO ──────────────────────────────────
NEXT_PUBLIC_BARBERIA_NOMBRE="Nombre Barbería"
NEXT_PUBLIC_BARBERIA_ROLE="Master Barber"
NEXT_PUBLIC_BARBERIA_TAGLINE="Tu tagline aquí."
NEXT_PUBLIC_BARBERIA_DESCRIPCION="Descripción breve del negocio."
NEXT_PUBLIC_BARBERIA_INSTAGRAM="handle.instagram"
NEXT_PUBLIC_BARBERIA_TELEFONO="600 000 000"
NEXT_PUBLIC_BARBERIA_URL="https://tudominio.com"

# Dirección — completa (para mostrar) y desglosada (para SEO/Schema.org)
NEXT_PUBLIC_BARBERIA_DIRECCION="Calle Ejemplo, 1, 12345 Ciudad, Provincia"
NEXT_PUBLIC_BARBERIA_CALLE="Calle Ejemplo, 1"
NEXT_PUBLIC_BARBERIA_CP="12345"
NEXT_PUBLIC_BARBERIA_LOCALIDAD="Ciudad"
NEXT_PUBLIC_BARBERIA_PROVINCIA="Provincia"
NEXT_PUBLIC_BARBERIA_CIUDAD="Ciudad, Provincia"
NEXT_PUBLIC_BARBERIA_LATITUD="40.4168"
NEXT_PUBLIC_BARBERIA_LONGITUD="-3.7038"

# Foto del profesional — URL absoluta (https://...) o ruta local (/foto.jpg en /public)
NEXT_PUBLIC_BARBERIA_FOTO_URL="/foto-barbero.jpg"

# ── SECCIÓN SOBRE MÍ ─────────────────────────────────────────
NEXT_PUBLIC_SOBRE_MI_BIO_1="Primer párrafo de presentación del profesional."
NEXT_PUBLIC_SOBRE_MI_BIO_2="Segundo párrafo de presentación del profesional."
NEXT_PUBLIC_SOBRE_MI_QUOTE="Tu frase característica aquí."
NEXT_PUBLIC_SOBRE_MI_STAT1_VALOR="10+"
NEXT_PUBLIC_SOBRE_MI_STAT1_LABEL="Años de experiencia"
NEXT_PUBLIC_SOBRE_MI_STAT2_VALOR="3k+"
NEXT_PUBLIC_SOBRE_MI_STAT2_LABEL="Cortes realizados"

# ── SEO / META (opcionales — se generan automáticamente si no se definen) ────
# NEXT_PUBLIC_SEO_TITLE_HOME="Nombre Barbería — Barbería de Caballeros"
# NEXT_PUBLIC_SEO_TITLE_RESERVA="Reservar Cita — Nombre Barbería"
# NEXT_PUBLIC_SEO_DESC_HOME="Reserva tu cita en Nombre Barbería..."
# NEXT_PUBLIC_SEO_DESC_RESERVA="Reserva tu cita online en Nombre Barbería."

# ── LEGAL / RGPD ─────────────────────────────────────────────
NEXT_PUBLIC_LEGAL_RESPONSABLE="Nombre Legal Completo"
NEXT_PUBLIC_LEGAL_EMAIL="legal@tudominio.com"

# ── COLORES DE MARCA ─────────────────────────────────────────
# Formato hex (#RRGGBB). Solo se necesita COLOR_PRIMARY; los demás son opcionales.
# Herramienta para generar paleta: https://m3.material.io/theme-builder
NEXT_PUBLIC_COLOR_PRIMARY="#755B00"
NEXT_PUBLIC_COLOR_PRIMARY_DIM="#584400"             # Variante más oscura del primary
NEXT_PUBLIC_COLOR_PRIMARY_CONTAINER="#FFE08F"       # Fondo suave (chips, badges)
NEXT_PUBLIC_COLOR_ON_PRIMARY_CONTAINER="#241A00"    # Texto sobre primary-container

# ── PWA MANIFEST (opcionales — se generan desde el nombre si no se definen) ──
# NEXT_PUBLIC_MANIFEST_NOMBRE="Nombre Barbería — Admin"
# NEXT_PUBLIC_MANIFEST_SHORT_NAME="NB Admin"
# NEXT_PUBLIC_MANIFEST_DESCRIPCION="Panel de administración de Nombre Barbería"
